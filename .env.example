# ==========================================
# MARIYAM MAQUILLAGE — ENVIRONMENT CONFIGURATION
# Copy this file to .env or configure in your deployment dashboard (e.g. Vercel)
# ==========================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production

# Server-Side Gemini API (Used for Live AI Beauty Advisor & Chromatic Diagnosis)
# In Google AI Studio Build, this key is provided automatically.
# In self-hosted or external Vercel deployments, provide your Google AI Studio API key.
GEMINI_API_KEY=

# Payment Gateway (Razorpay India)
# Optional in development; when omitted, the atelier runs in secure verified Sandbox mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public Site Configuration (Client exposed)
VITE_SITE_URL=https://www.mariyammaquillage.com
VITE_APP_TITLE=Mariyam Maquillage | Luxury Indian Beauty & AI Shade Studio
VITE_APP_ENVIRONMENT=production